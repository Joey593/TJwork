# 快速本地演示默认 SQLite；MySQL 可使用下列连接串。
# DATABASE_URL=mysql+pymysql://aurora:change-this-password@127.0.0.1:3306/aurora?charset=utf8mb4
ADMIN_PASSWORD=Admin12345!
# 生产部署设置至少 32 字符随机值。为空时自动生成并写入 data/.jwt-secret。
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_BASE_URL=http://127.0.0.1:8000
# OpenAI 兼容 Chat Completions API，密钥只存服务端。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# 使用本机 Chromium 可设置。留空则使用 playwright install 下载的浏览器。
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/usr/bin/chromium
# Docker Compose 数据库配置；根目录 .env 已按所有者要求版本化。
MYSQL_PASSWORD=change-this-password
MYSQL_ROOT_PASSWORD=change-root-password
